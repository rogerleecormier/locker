{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locker",
  "main": "src/ssr.tsx",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "locker-db",
      "database_id": "6091fbef-95a2-4235-b97e-cc1f360f73b2",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "locker-memories-v2"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "BETTER_AUTH_URL": "https://locker.rcormier.dev"
  },
  "queues": {
    "producers": [
      {
        "binding": "ARCHIVE_QUEUE",
        "queue": "locker-archive-queue"
      }
    ],
    "consumers": [
      {
        "queue": "locker-archive-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
