{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locker",
  "main": "src/ssr.tsx",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "locker-db",
      "database_id": "6091fbef-95a2-4235-b97e-cc1f360f73b2"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "locker-memories"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
