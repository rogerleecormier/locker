{
  "name": "locker",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply locker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply locker-db --remote",
    "db:seed": "tsx scripts/seed-templates.ts",
    "db:studio": "drizzle-kit studio",
    "cf:d1:create": "wrangler d1 create locker-db",
    "cf:vectorize:create": "wrangler vectorize create locker-memories --dimensions=1024 --metric=cosine",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerleecormier/locker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rogerleecormier/locker/issues"
  },
  "homepage": "https://github.com/rogerleecormier/locker#readme",
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.11",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-query-devtools": "5.100.14",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-start": "1.168.14",
    "@tanstack/router-devtools": "1.167.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "4.20260526.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "wrangler": "4.95.0"
  }
}
